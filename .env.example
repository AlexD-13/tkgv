# Backend (runtime variables, injected with --env-file or compose)
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/gestionplatos
DB_SSLMODE=require
SECRET_KEY=change-me-for-production
ADMIN_TOKEN=change-me-admin-token
CORS_ORIGINS=http://localhost:8000

# Frontend (BUILD-TIME only: pass as --build-arg, not runtime env)
# NUXT_PUBLIC_API_BASE=https://your-domain.example/api
# NUXT_PUBLIC_SITE_URL=https://your-domain.example